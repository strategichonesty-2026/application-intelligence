# Names only: copy to .env for local use. NEVER commit real values. On Railway set these as service variables.
# This app's OWN database (a separate database inside your Postgres, not Media Studio's):
DATABASE_URL=
# Sign-in, EASY: one passphrase of 16 or more characters (letters, spaces and digits are fine):
# APP_INTELLIGENCE_OWNER_PASSWORD=
# Sign-in, STRONGER (no passphrase stored as text): make a hash and secret with node server/scripts/hashOwnerPassword.cjs and set both:
APP_INTELLIGENCE_OWNER_PASSWORD_HASH=
APP_INTELLIGENCE_SESSION_SECRET=
# Optional:
# APP_INTELLIGENCE_ENV=production
# APP_INTELLIGENCE_SCHEDULE=off          # "daily" turns on ONE automatic check a day
# APP_INTELLIGENCE_DAILY_UTC_HOUR=6
# TRUST_PROXY_HOPS=1
# RESEND_API_KEY=  ALERT_EMAIL_FROM=  ALERT_EMAIL_TO=
# APP_INTELLIGENCE_HEARTBEAT_URL=
# APP_INTELLIGENCE_DB_SSL=off            # local database only
